<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== 1. 全局 attr（只定义一次） ==================== -->
    <!-- 所有属性以 _L 结尾，作为项目自有 namespace，避免与第三方库（com.hjq.shape / CardView 等）冲突 -->

    <!-- 形状类型：rectangle 矩形 / oval 椭圆 / line 线条 / ring 圆环 -->
    <attr name="shape_L">
        <!-- 不指定形状（保持默认） -->
        <enum name="none" value="-1" />
        <!-- 矩形（默认值） -->
        <enum name="rectangle" value="0" />
        <!-- 椭圆/圆形 -->
        <enum name="oval" value="1" />
        <!-- 线条 -->
        <enum name="line" value="2" />
        <!-- 圆环 -->
        <enum name="ring" value="3" />
    </attr>

    <!-- 形状显式宽度（仅当形状自身需要尺寸时生效，如 oval/ring） -->
    <attr name="shape_width_L" format="dimension" />
    <!-- 形状显式高度（仅当形状自身需要尺寸时生效，如 oval/ring） -->
    <attr name="shape_height_L" format="dimension" />

    <!-- ============ 实心填充（背景色） ============ -->
    <!-- 默认状态的实心填充颜色 -->
    <attr name="shape_solidColor_L" format="color" />
    <!-- 按下状态（state_pressed）的填充颜色 -->
    <attr name="shape_solidPressedColor_L" format="color" />
    <!-- 选中状态（state_checked）的填充颜色，适用于 CheckBox/RadioButton 等 -->
    <attr name="shape_solidCheckedColor_L" format="color" />
    <!-- 禁用状态（!state_enabled）的填充颜色 -->
    <attr name="shape_solidDisabledColor_L" format="color" />
    <!-- 获取焦点状态（state_focused）的填充颜色 -->
    <attr name="shape_solidFocusedColor_L" format="color" />
    <!-- 选中状态（state_selected）的填充颜色 -->
    <attr name="shape_solidSelectedColor_L" format="color" />

    <!-- ============ 实心渐变 ============ -->
    <!-- 渐变起始色（必须与 EndColor 同时设置才生效，设置后会覆盖 solidColor） -->
    <attr name="shape_solidGradientStartColor_L" format="color" />
    <!-- 渐变中间色（可选，三色渐变时使用） -->
    <attr name="shape_solidGradientCenterColor_L" format="color" />
    <!-- 渐变结束色 -->
    <attr name="shape_solidGradientEndColor_L" format="color" />
    <!-- 渐变方向（仅对 linear 线性渐变生效） -->
    <attr name="shape_solidGradientOrientation_L">
        <!-- 从左到右 -->
        <enum name="leftToRight" value="0" />
        <!-- 从左上到右下 -->
        <enum name="topLeftToBottomRight" value="1" />
        <!-- 从上到下 -->
        <enum name="topToBottom" value="2" />
        <!-- 从右上到左下 -->
        <enum name="topRightToBottomLeft" value="3" />
        <!-- 从右到左 -->
        <enum name="rightToLeft" value="4" />
        <!-- 从右下到左上 -->
        <enum name="bottomRightToTopLeft" value="5" />
        <!-- 从下到上 -->
        <enum name="bottomToTop" value="6" />
        <!-- 从左下到右上 -->
        <enum name="bottomLeftToTopRight" value="7" />
    </attr>
    <!-- 渐变类型 -->
    <attr name="shape_solidGradientType_L">
        <!-- 线性渐变（默认） -->
        <enum name="linear" value="0" />
        <!-- 径向渐变（从中心向外发散） -->
        <enum name="radial" value="1" />
        <!-- 扫描渐变（绕中心旋转） -->
        <enum name="sweep" value="2" />
    </attr>
    <!-- 径向渐变的半径（仅 radial 类型生效） -->
    <attr name="shape_solidGradientRadius_L" format="dimension" />
    <!-- 渐变中心点 X 坐标（0~1，相对值，默认 0.5） -->
    <attr name="shape_solidGradientCenterX_L" format="float" />
    <!-- 渐变中心点 Y 坐标（0~1，相对值，默认 0.5） -->
    <attr name="shape_solidGradientCenterY_L" format="float" />
    <!-- 渐变是否随 level 变化（配合 ClipDrawable 等使用，一般为 false） -->
    <attr name="shape_solidGradientUseLevel_L" format="boolean" />

    <!-- ============ 圆角 ============ -->
    <!-- 统一圆角半径（四个角相同），若设置了单角则该值作为兜底 -->
    <attr name="shape_radius_L" format="dimension" />
    <!-- 左上角圆角半径（独立设置后覆盖 shape_radius_L） -->
    <attr name="shape_topLeftRadius_L" format="dimension" />
    <!-- 右上角圆角半径 -->
    <attr name="shape_topRightRadius_L" format="dimension" />
    <!-- 左下角圆角半径 -->
    <attr name="shape_bottomLeftRadius_L" format="dimension" />
    <!-- 右下角圆角半径 -->
    <attr name="shape_bottomRightRadius_L" format="dimension" />

    <!-- ============ 描边 ============ -->
    <!-- 默认状态的描边颜色（需配合 shape_strokeSize_L 使用） -->
    <attr name="shape_strokeColor_L" format="color" />
    <!-- 按下状态的描边颜色 -->
    <attr name="shape_strokePressedColor_L" format="color" />
    <!-- 选中状态（state_checked）的描边颜色 -->
    <attr name="shape_strokeCheckedColor_L" format="color" />
    <!-- 禁用状态的描边颜色 -->
    <attr name="shape_strokeDisabledColor_L" format="color" />
    <!-- 获取焦点状态的描边颜色 -->
    <attr name="shape_strokeFocusedColor_L" format="color" />
    <!-- 选中状态（state_selected）的描边颜色 -->
    <attr name="shape_strokeSelectedColor_L" format="color" />
    <!-- 描边粗细（>0 时才会绘制描边） -->
    <attr name="shape_strokeSize_L" format="dimension" />
    <!-- 虚线段长度（>0 时描边为虚线） -->
    <attr name="shape_strokeDashSize_L" format="dimension" />
    <!-- 虚线段间隔（与 shape_strokeDashSize_L 配合使用） -->
    <attr name="shape_strokeDashGap_L" format="dimension" />

    <!-- ============ 描边渐变（注意：受 GradientDrawable 限制，实际仅取起始色） ============ -->
    <!-- 描边渐变起始色 -->
    <attr name="shape_strokeGradientStartColor_L" format="color" />
    <!-- 描边渐变中间色 -->
    <attr name="shape_strokeGradientCenterColor_L" format="color" />
    <!-- 描边渐变结束色 -->
    <attr name="shape_strokeGradientEndColor_L" format="color" />
    <!-- 描边渐变方向 -->
    <attr name="shape_strokeGradientOrientation_L">
        <enum name="leftToRight" value="0" />
        <enum name="topLeftToBottomRight" value="1" />
        <enum name="topToBottom" value="2" />
        <enum name="topRightToBottomLeft" value="3" />
        <enum name="rightToLeft" value="4" />
        <enum name="bottomRightToTopLeft" value="5" />
        <enum name="bottomToTop" value="6" />
        <enum name="bottomLeftToTopRight" value="7" />
    </attr>

    <!-- ============ Ring 圆环（shape_L="ring" 时生效） ============ -->
    <!-- 圆环内径（绝对值，与 ratio 二选一） -->
    <attr name="shape_innerRadius_L" format="dimension" />
    <!-- 圆环内径比例（控件宽度 / 该值 = 内径，默认 3） -->
    <attr name="shape_innerRadiusRatio_L" format="float" />
    <!-- 圆环厚度（绝对值，与 ratio 二选一） -->
    <attr name="shape_thickness_L" format="dimension" />
    <!-- 圆环厚度比例（控件宽度 / 该值 = 厚度，默认 9） -->
    <attr name="shape_thicknessRatio_L" format="float" />
    <!-- 是否随 level 变化（配合进度条等） -->
    <attr name="shape_useLevel_L" format="boolean" />

    <!-- ============ Line 线条（shape_L="line" 时生效） ============ -->
    <!-- 线条对齐方式（多个 flag 可组合） -->
    <attr name="shape_lineGravity_L">
        <flag name="top" value="0x30" />
        <flag name="bottom" value="0x50" />
        <flag name="center_vertical" value="0x10" />
        <flag name="left" value="0x03" />
        <flag name="right" value="0x05" />
        <flag name="center_horizontal" value="0x01" />
        <flag name="center" value="0x11" />
    </attr>

    <!-- ==================== 阴影（仿 CardView） ==================== -->
    <!-- 阴影高度（z 轴），值越大阴影越扩散，>0 时才会有阴影 -->
    <attr name="shape_shadowElevation_L" format="dimension" />
    <!-- 最大阴影高度（用于 padding 兼容计算，默认等于 shape_shadowElevation_L） -->
    <attr name="shape_shadowMaxElevation_L" format="dimension" />
    <!-- 是否启用兼容 padding（true 时为阴影预留空间，类似 CardView 的 cardUseCompatPadding） -->
    <attr name="shape_shadowUseCompatPadding_L" format="boolean" />
    <!-- 是否防止圆角处内容溢出（true 时自动给子 View 加内边距） -->
    <attr name="shape_shadowPreventCornerOverlap_L" format="boolean" />
    <!-- 阴影主光源颜色（所有 API 版本均支持；设置后走自绘彩色阴影） -->
    <attr name="shape_shadowSpotColor_L" format="color" />
    <!-- 阴影环境光颜色（所有 API 版本均支持；设置后走自绘彩色阴影） -->
    <attr name="shape_shadowAmbientColor_L" format="color" />
    <!-- 阴影透明度，0.0（完全透明）~ 1.0（完全不透明），默认 1.0；叠加在阴影颜色 alpha 之上 -->
    <attr name="shape_shadowAlpha_L" format="float" />
    <!-- 阴影水平偏移，正值向右，负值向左，默认 0 -->
    <attr name="shape_shadowOffsetX_L" format="dimension" />
    <!-- 阴影垂直偏移，正值向下，负值向上，默认 0 -->
    <attr name="shape_shadowOffsetY_L" format="dimension" />


