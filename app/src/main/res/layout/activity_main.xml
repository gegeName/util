<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/btnBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ── 控制类 ────────────────────────────────────────── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/btnRefresh"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="刷新" />

                <Button
                    android:id="@+id/btnRetry"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重试" />

                <Button
                    android:id="@+id/btnAutoRefresh"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动刷新" />

                <Button
                    android:id="@+id/btnScrollTop"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="回到顶部" />

                <Button
                    android:id="@+id/btnSnapshot"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快照" />

                <Button
                    android:id="@+id/btnItemCount"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="条数" />

                <Button
                    android:id="@+id/btnClear"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="清空" />

                <Button
                    android:id="@+id/btnCancelAll"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="取消全部" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ── 直接更新（patch） ─────────────────────────────── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/btnUpdate"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="改字段" />

                <Button
                    android:id="@+id/btnReplace"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="整条替换" />

                <Button
                    android:id="@+id/btnUpdateAll"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="批量改" />

                <Button
                    android:id="@+id/btnDelete"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="删除" />

                <Button
                    android:id="@+id/btnDeleteMany"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="删除3条" />

                <Button
                    android:id="@+id/btnUndelete"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="撤回删除" />

                <Button
                    android:id="@+id/btnInsertHead"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="头部插入" />

                <Button
                    android:id="@+id/btnInsertHeadList"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="头部插入3条" />

                <Button
                    android:id="@+id/btnUnpatch"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="撤销补丁" />

                <Button
                    android:id="@+id/btnClearLocal"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="清本地修改" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ── 乐观更新 ─────────────────────────────────────── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/btnOptUpdateOk"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="乐观改-成功" />

                <Button
                    android:id="@+id/btnOptUpdateFail"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="乐观改-失败" />

                <Button
                    android:id="@+id/btnOptUpdateThrottle"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="乐观改-节流" />

                <Button
                    android:id="@+id/btnOptDelete"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="乐观删除" />

                <Button
                    android:id="@+id/btnOptInsertHead"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="乐观头部插入" />

                <Button
                    android:id="@+id/btnCancelKey"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按key取消" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ── 先请求再改本地 ─────────────────────────────────── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <com.simple.mylibrary.weiget.ShapeTextView
                    android:id="@+id/btnServerUpdate"
                    android:layout_width="wrap_content"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    app:shape_shadowElevation_L="4dp"
                    android:text="服务端改" />


                <Button
                    android:id="@+id/btnServerDelete"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务端删" />

                <Button
                    android:id="@+id/btnServerInsertHead"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务端插入" />

                <Button
                    android:id="@+id/btnJumpViewActivity"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="跳转到ViewActivity" />

                <Button
                    android:id="@+id/btnSpanActivity"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="跳转到SpanActivity" />

                <Button
                    android:id="@+id/btnSpanRecyclerActivity"
                    style="?attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Span复用测试" />
                <com.simple.mylibrary.weiget.ShapeEditText
                    app:shape_radius_L="6dp"
                    android:textSize="12sp"
                    android:hint="数量减少"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:gravity="start|center_vertical"
                    app:shape_solidColor_L="#D3D3D3"
                    app:shape_strokeColor_L="@color/black"
                    app:shape_strokeSize_L="1dp"
                    android:layout_width="100dp"
                    android:layout_height="35dp"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>



    <com.simple.mylibrary.http.StateLayout
        android:id="@+id/pageState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:stlStateBackground="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBar" >
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </com.simple.mylibrary.http.StateLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
