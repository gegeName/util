<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".SpanActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- ========================================================== -->
        <!-- 1. append + color + bold + italic + boldItalic + underline -->
        <!--    + strikethrough                                          -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="1. append + color/bold/italic/boldItalic/underline/strikethrough" />

        <TextView
            android:id="@+id/tv_demo_append_styles"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 2. appendLine + sizePx + backgroundColor                    -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="2. appendLine + sizePx + backgroundColor" />

        <TextView
            android:id="@+id/tv_demo_append_line"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 3. image(resId, w, h) 本地资源                              -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="3. image(resId, w, h) 本地资源 + CenterAlignImageSpan 居中" />

        <TextView
            android:id="@+id/tv_demo_image_res"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 4. image(drawable) Drawable 对象                            -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="4. image(drawable, w, h) 直接传 Drawable" />

        <TextView
            android:id="@+id/tv_demo_image_drawable"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 5. image(bitmap) Bitmap                                     -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="5. image(bitmap, w, h) 传入 Bitmap" />

        <TextView
            android:id="@+id/tv_demo_image_bitmap"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 6. image(url) 远程 URL 图(Glide 异步加载)                 -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="6. image(url, w, h, circle) 远程 URL,Glide 异步加载" />

        <TextView
            android:id="@+id/tv_demo_image_url"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 7. setText + find + color/bold                              -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="7. setText + find(keyword) 命中首个匹配再上色加粗" />

        <TextView
            android:id="@+id/tv_demo_find"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 8. setText + findAll(ignoreCase = true)                     -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="8. setText + findAll(keyword, ignoreCase) 命中全部" />

        <TextView
            android:id="@+id/tv_demo_find_all"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 9. setText + findRegex                                      -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="9. setText + findRegex(正则)" />

        <TextView
            android:id="@+id/tv_demo_find_regex"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 10. setText + range(start, end)                             -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="10. setText + range(s, e) 显式下标范围" />

        <TextView
            android:id="@+id/tv_demo_range"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 11. setText + all()                                         -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="11. setText + all() 整段统一上样式" />

        <TextView
            android:id="@+id/tv_demo_all"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 12. replaceWithImage(placeholder, resId)                    -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="12. replaceWithImage(placeholder, resId) 占位符 → 本地图" />

        <TextView
            android:id="@+id/tv_demo_replace_res"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 13. replaceWithImage 多占位符(测试位移修复)               -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="13. replaceWithImage 多个占位符 + 后续 find 上色(验证位移)" />

        <TextView
            android:id="@+id/tv_demo_replace_multi"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 14. replaceWithImage(placeholder, drawable)                 -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="14. replaceWithImage(placeholder, drawable)" />

        <TextView
            android:id="@+id/tv_demo_replace_drawable"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 15. replaceWithImage(placeholder, url)                      -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="15. replaceWithImage(placeholder, url, w, h, circle)" />

        <TextView
            android:id="@+id/tv_demo_replace_url"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 16. maxLength                                               -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="16. maxLength(maxChars, ellipsis) 超出截断 + 样式延展到省略号" />

        <TextView
            android:id="@+id/tv_demo_max_length"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 17. marginPx 文字片段:左右插占位 + 上下 baselineShift     -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="17. marginPx 文字片段:左右距离 + 上下平移(baselineShift)" />

        <TextView
            android:id="@+id/tv_demo_margin_text"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 18. marginPx 图片片段:InsetDrawable 包裹                  -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="18. marginPx 图片片段:InsetDrawable 四方向间距" />

        <TextView
            android:id="@+id/tv_demo_margin_image"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 19. textVerticalMarginPx 全文字上下统一平移               -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="19. textVerticalMarginPx 全文字上下统一平移(配合图片视觉居中)" />

        <TextView
            android:id="@+id/tv_demo_text_vertical_margin"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 20. onClick (默认沿用 color,不加下划线)                   -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="20. onClick(默认无下划线,保留 color 设的颜色)" />

        <TextView
            android:id="@+id/tv_demo_click_simple"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 21. onClick(underline = true, overrideColor)                -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="21. onClick(underline=true, overrideColor) 强制下划线/颜色" />

        <TextView
            android:id="@+id/tv_demo_click_styled"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 22. build() 直接拿 CharSequence,自己 setText               -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="22. build() 直接拿 CharSequence(不会触发 URL 加载)" />

        <TextView
            android:id="@+id/tv_demo_build"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 23. 综合:服务端文案模式典型用法                            -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="23. 综合演示:服务端整段文案 + 多种 find/replace 链式" />

        <TextView
            android:id="@+id/tv_demo_combo"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 24. gradientColor 横向二色 + 多色                          -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="24. gradientColor 横向:二色 + 多色(带 positions)" />

        <TextView
            android:id="@+id/tv_demo_gradient_horizontal"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 25. gradientColor vertical=true 纵向渐变                   -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="25. gradientColor vertical=true 纵向渐变" />

        <TextView
            android:id="@+id/tv_demo_gradient_vertical"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 26. maxLengthMiddle 中间截断                                -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="26. maxLengthMiddle(maxChars, ellipsis) 中间截断,保留头尾" />

        <TextView
            android:id="@+id/tv_demo_max_length_middle"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 27. appendLine() 空参重载,仅插入换行                       -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="27. appendLine() 空参重载,仅插入换行(分隔多段)" />

        <TextView
            android:id="@+id/tv_demo_append_line_empty"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 28. stroke 文字描边                                         -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="28. stroke(color, width) 文字描边" />

        <TextView
            android:id="@+id/tv_demo_stroke"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 29. glow 文字发光                                           -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="29. glow(color, radius) 文字发光" />

        <TextView
            android:id="@+id/tv_demo_glow"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 30. 渐变 + 描边 + 发光 三合一                              -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="30. gradientColor + stroke + glow 三合一" />

        <TextView
            android:id="@+id/tv_demo_decoration_combo"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 31. imageBorder 本地图 纯色边框                             -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="31. imageBorder(color, width, cornerRadius) 本地图纯色边框" />

        <TextView
            android:id="@+id/tv_demo_image_border_solid"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 32. imageBorderGradient 本地图 渐变边框                     -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="32. imageBorderGradient 本地图渐变边框(横向+纵向)" />

        <TextView
            android:id="@+id/tv_demo_image_border_gradient"
            style="@style/Demo" />


        <!-- ========================================================== -->
        <!-- 33. imageBorder URL 图 异步加载 + 边框                      -->
        <!-- ========================================================== -->
        <TextView
            style="@style/Section"
            android:text="33. imageBorder URL 图 异步加载完成后附加边框" />

        <TextView
            android:id="@+id/tv_demo_image_border_url"
            style="@style/Demo" />

    </LinearLayout>

</ScrollView>
